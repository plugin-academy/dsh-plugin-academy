{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugin.academy/dsh/schema/dsh-index.schema.json",
  "title": "DSH format-1 publishing schema; native validator is authoritative",
  "type": "object",
  "required": ["format", "title", "plugins"],
  "properties": {
    "format": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "metadata": { "type": "object" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "repository", "versions"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 214 },
          "title": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "author": { "type": "string", "minLength": 1 },
          "homepage": { "type": "string", "format": "uri" },
          "icon": { "type": "string", "minLength": 1 },
          "metadata": { "type": ["object", "null"] },
          "repository": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "directory": { "type": "string", "minLength": 1 }
            }
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["version", "publishTimestamp", "source"],
              "properties": {
                "version": { "type": "string", "minLength": 1 },
                "publishTimestamp": { "type": "number", "minimum": 0 },
                "engines": { "type": "object", "properties": { "dsh": { "type": "string" } } },
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["type"],
                      "properties": { "type": { "const": "npm" }, "registry": { "type": "string", "format": "uri" } }
                    },
                    {
                      "type": "object",
                      "required": ["type", "url", "commit"],
                      "properties": {
                        "type": { "const": "git" },
                        "url": { "type": "string", "format": "uri" },
                        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                        "path": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["en"], "additionalProperties": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
